<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeof="xml"?>
<package format="3">
  <name>orbslam3</name>
  <version>0.0.1</version>
  <description>ORB-SLAM3 library packaged for CMake/colcon.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>eigen3</depend>
  <depend>sophus</depend>
  <depend>opencv4</depend>
  <depend>fbow</depend>
  <depend>gtsam</depend>

  <!-- vo + wrapper dependencies -->
  <depend>lcm_log_player</depend>
  <depend>acfr_lcm_types</depend>
  <depend>static_tf</depend>
  <depend>boost</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
